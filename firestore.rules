rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitives
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }

    function hasProfile(userId) {
      return exists(/databases/$(database)/documents/users/$(userId));
    }

    function getProfile(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    function isAdminOfCompany(companyId) {
      return isSignedIn() && 
             companyId != null && companyId != "" && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)/memberships/$(companyId)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)/memberships/$(companyId)).data.get("role", "") == "admin";
    }

    function isMemberOfCompany(companyId) {
      return isSignedIn() && 
             companyId != null && companyId != "" && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)/memberships/$(companyId));
    }

    // RBAC: Check if user is a Global Admin (bootstrapped)
    function isGlobalAdmin() {
      // Add user email from metadata if needed, but for now we rely on company-level admin
      return isSignedIn() && request.auth.token.email == "vikasgupta122009@gmail.com";
    }

    // 1. User Profiles
    match /users/{userId} {
      function isValidUser(data) {
        return (data.get("uid", "") == userId || data.get("uid", "") == "") &&
               (data.get("role", "") == "admin" || data.get("role", "") == "worker") &&
               data.get("name", "").size() <= 100;
      }

      allow get: if isSignedIn();
      allow list: if isSignedIn() && (
        isOwner(userId) || 
        isGlobalAdmin() || 
        (resource.data.companyId != "" && exists(/databases/$(database)/documents/users/$(request.auth.uid)/memberships/$(resource.data.companyId)))
      );
      
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && (
        // Prevent self-elevation of role unless they are already an admin of their active workspace
        // This is complex, so we strictly check affectedKeys
        incoming().diff(existing()).affectedKeys().hasOnly(["companyId", "companyCode", "companyName", "role", "activeWorkspace", "updatedAt", "name"])
      ) || isAdminOfCompany(existing().get("companyId", ""));

      // Memberships sub-collection
      match /memberships/{companyId} {
        allow read: if isSignedIn() && (isOwner(userId) || isAdminOfCompany(companyId));
        allow create: if isOwner(userId) || isAdminOfCompany(companyId);
        allow update: if isOwner(userId) || isAdminOfCompany(companyId);
        allow delete: if isOwner(userId) || isAdminOfCompany(companyId);
      }
    }

    // 2. Companies
    match /companies/{companyId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && incoming().adminId == request.auth.uid && incoming().get("code", "").size() == 6;
      allow update: if isSignedIn() && (existing().adminId == request.auth.uid || isGlobalAdmin());
      allow delete: if isSignedIn() && (existing().adminId == request.auth.uid || isGlobalAdmin());
    }

    // 3. Attendance
    match /attendance/{attendanceId} {
      function isValidAttendance(data) {
        return data.userId is string && isValidId(data.userId) &&
               data.status in ["present", "absent"] &&
               data.get("companyId", "") is string &&
               data.get("date", "").size() == 10;
      }

      allow list: if isSignedIn() && (
        resource.data.userId == request.auth.uid || 
        isMemberOfCompany(resource.data.get("companyId", ""))
      );
      
      allow get: if isSignedIn() && (
        resource.data.userId == request.auth.uid || 
        isMemberOfCompany(resource.data.get("companyId", ""))
      );

      allow create: if isSignedIn() && (
        (isOwner(incoming().userId) && isValidAttendance(incoming()) && incoming().get("modifiedByAdmin", false) == false) ||
        (incoming().get("companyId", "") != "" && isAdminOfCompany(incoming().companyId))
      );

      allow update: if isSignedIn() && (
        // Admin Override
        (existing().get("companyId", "") != "" && isAdminOfCompany(existing().companyId) && 
         incoming().diff(existing()).affectedKeys().hasAny(["status", "modifiedByAdmin", "updatedAt", "checkInTime"])) ||
        // User Update (Clock-in)
        (isOwner(existing().userId) && isValidAttendance(incoming()) && !existing().get("modifiedByAdmin", false) &&
         incoming().diff(existing()).affectedKeys().hasOnly(["status", "updatedAt", "checkInTime", "location", "method", "companyId", "companyCode", "id", "userId", "date"]))
      );
      
      allow delete: if isSignedIn() && isAdminOfCompany(existing().get("companyId", ""));
    }

    // 4. Messages
    match /messages/{messageId} {
      function isValidMessage(data) {
        return data.senderId is string && isValidId(data.senderId) &&
               data.content is string && data.content.size() <= 1000 &&
               data.get("companyId", "") is string;
      }

      allow list: if isSignedIn() && (
        resource.data.senderId == request.auth.uid || 
        resource.data.receiverId == request.auth.uid ||
        (resource.data.get("type", "") == "group" && isMemberOfCompany(resource.data.get("companyId", "")))
      );
      
      allow get: if isSignedIn() && (
        resource.data.senderId == request.auth.uid || 
        resource.data.receiverId == request.auth.uid ||
        (resource.data.get("type", "") == "group" && isMemberOfCompany(resource.data.get("companyId", "")))
      );

      allow create: if isSignedIn() && isOwner(incoming().senderId) && isValidMessage(incoming());
      allow update: if isSignedIn() && (
        (resource.data.get("receiverId", null) == request.auth.uid || resource.data.get("type", "") == "group") && 
        incoming().diff(existing()).affectedKeys().hasAny(["read", "readBy"])
      );
      allow delete: if isSignedIn() && (resource.data.senderId == request.auth.uid || isAdminOfCompany(resource.data.get("companyId", "")));
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email in ['vikasgupta122009@gmail.com', 'heartcartoons1@gmail.com', 'vikas122009@gmail.com'] ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'worker') == 'admin')
      );
    }

    function isMember() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- User Profiles & Meta ---
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      
      function isValidUser(data) {
        return data.email is string &&
               data.role in ['admin', 'worker'] &&
               data.fullName is string;
      }

      // Allow owner to update themselves, OR admins to update group/role of members
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) || (
        isAdmin() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.groupId == existing().groupId &&
        (incoming().diff(existing()).affectedKeys().hasOnly(['groupId', 'role', 'updatedAt']))
      );

      match /profiles/{profileId} {
        allow get, list: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId) && isValidId(profileId);
        allow delete: if isOwner(userId) || isAdmin();
      }
    }

    // --- Attendance Records ---
    match /attendance/{recordId} {
      function isValidAttendance(data) {
        return (data.userId == request.auth.uid || isAdmin()) &&
               data.type in ['in', 'out'] &&
               data.groupId is string &&
               (data.get('method', 'GPS') == 'manual' || (data.location.lat is number && data.location.lng is number));
      }

      allow create: if isSignedIn() && isValidAttendance(incoming());
      allow get: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (
        resource.data.userId == request.auth.uid || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('groupId', 'none') == resource.data.groupId)
      );
      allow update: if isAdmin() && isValidAttendance(incoming());
      allow delete: if isAdmin(); 
    }

    // --- Leave Requests ---
    match /leaves/{leaveId} {
      function isValidLeave(data) {
        return data.userId is string && data.groupId is string && data.reason is string;
      }
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && isValidLeave(incoming());
      allow get: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (
        resource.data.userId == request.auth.uid || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('groupId', 'none') == resource.data.groupId)
      );
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // --- Announcements ---
    match /announcements/{announcementId} {
      allow list: if isSignedIn() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('groupId', 'none') == resource.data.groupId
      );
      allow get: if isSignedIn();
      allow write: if isAdmin();
    }

    // --- Messages ---
    match /messages/{messageId} {
      allow list: if isSignedIn() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('groupId', 'none') == resource.data.groupId
      );
      allow get: if isSignedIn();
      allow create: if isSignedIn() && incoming().senderId == request.auth.uid && incoming().groupId is string;
      allow update, delete: if isAdmin();
    }

    // --- Groups ---
    match /groups/{groupId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        resource.data.createdBy == request.auth.uid || 
        isAdmin()
      );
      allow delete: if isAdmin() && resource.data.createdBy == request.auth.uid;
    }

    // --- System Test ---
    match /test/connection {
      allow read: if true;
    }
  }
}

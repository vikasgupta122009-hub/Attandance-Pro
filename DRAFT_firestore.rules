rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitives
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function myCompanyId() {
      return myProfile().get('companyId', '');
    }

    function isAdminOfCompany(companyId) {
      return isSignedIn() && 
             companyId != null && companyId != '' &&
             exists(/databases/$(database)/documents/companies/$(companyId)) &&
             get(/databases/$(database)/documents/companies/$(companyId)).data.adminId == request.auth.uid;
    }

    function isMemberOfCompany(companyId) {
      return isSignedIn() && companyId != null && companyId != '' && (
        myCompanyId() == companyId ||
        isAdminOfCompany(companyId)
      );
    }

    // 1. User Profiles
    match /users/{userId} {
      function isValidUser(data) {
        return data.uid == userId &&
               data.role in ['admin', 'worker'] &&
               (data.get('companyId', '') is string);
      }

      allow get: if isSignedIn();
      allow list: if isSignedIn() && (
        isOwner(userId) || 
        (resource.data.get('companyId', '') != '' && isMemberOfCompany(resource.data.companyId)) ||
        (resource.data.get('companyCode', '') != '' && resource.data.companyCode == myProfile().get('companyCode', ''))
      );
      
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['role', 'name', 'companyId', 'companyCode', 'companyName', 'email', 'updatedAt', 'uid', 'activeWorkspace']) ||
        incoming().diff(existing()).affectedKeys().size() == 0
      );

      // Memberships sub-collection
      match /memberships/{companyId} {
        allow read, write: if isSignedIn() && (isOwner(userId) || isAdminOfCompany(companyId));
      }
    }

    // 2. Companies
    match /companies/{companyId} {
      function isValidCompany(data) {
        return data.get('id', companyId) == companyId &&
               data.adminId == request.auth.uid &&
               data.get('name', '') is string && data.name.size() > 0 &&
               data.get('code', '') is string && data.code.size() == 6;
      }

      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidCompany(incoming());
      allow update: if isSignedIn() && existing().adminId == request.auth.uid;
      allow delete: if isSignedIn() && existing().adminId == request.auth.uid;
    }

    // 3. Attendance
    match /attendance/{attendanceId} {
      function isValidAttendance(data) {
        return data.userId is string && isValidId(data.userId) &&
               data.status in ['present', 'absent'] &&
               (data.get('companyId', '') is string);
      }

      allow list: if isSignedIn() && (
        resource.data.userId == request.auth.uid || 
        isMemberOfCompany(resource.data.get('companyId', '')) ||
        (resource.data.get('companyCode', '') != '' && resource.data.companyCode == myProfile().get('companyCode', ''))
      );
      
      allow get: if isSignedIn();

      allow create: if isSignedIn() && (
        (isOwner(incoming().userId) && isValidAttendance(incoming()) && incoming().get('modifiedByAdmin', false) == false) ||
        (incoming().get('companyId', '') != '' && isAdminOfCompany(incoming().companyId))
      );

      allow update: if isSignedIn() && (
        (existing().get('companyId', '') != '' && isAdminOfCompany(existing().companyId) && 
         incoming().diff(existing()).affectedKeys().hasOnly(['status', 'modifiedByAdmin', 'updatedAt', 'method', 'checkInTime', 'id', 'userId', 'companyId', 'companyCode', 'date'])) ||
        (isOwner(existing().userId) && isValidAttendance(incoming()) && !existing().get('modifiedByAdmin', false) &&
         incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt', 'checkInTime', 'location', 'method', 'companyId', 'companyCode', 'id', 'userId', 'date']))
      );
    }

    // 4. Messages
    match /messages/{messageId} {
      function isValidMessage(data) {
        return data.senderId is string && isValidId(data.senderId) &&
               data.content is string && data.content.size() > 0 &&
               (data.get('companyId', '') is string);
      }

      allow list: if isSignedIn() && (
        resource.data.senderId == request.auth.uid || 
        resource.data.receiverId == request.auth.uid ||
        isMemberOfCompany(resource.data.get('companyId', ''))
      );
      
      allow get: if isSignedIn();
      allow create: if isSignedIn() && isOwner(incoming().senderId) && isValidMessage(incoming());
      allow update: if isSignedIn() && (
        (resource.data.get('receiverId', null) == request.auth.uid || resource.data.get('type', '') == 'group') && 
        incoming().diff(existing()).affectedKeys().hasAny(['read', 'readBy'])
      );
    }
  }
}

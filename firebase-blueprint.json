{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Stores user role and profile information",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "fullName": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "worker"] },
        "groupId": { "type": "string" },
        "activeProfileId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "role"]
    },
    "Attendance": {
      "title": "Attendance Record",
      "description": "Stores individual check-in and check-out events",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "type": { "type": "string", "enum": ["in", "out"] },
        "timestamp": { "type": "string", "format": "date-time" },
        "location": {
          "type": "object",
          "properties": {
            "lat": { "type": "number" },
            "lng": { "type": "number" },
            "address": { "type": "string" }
          }
        },
        "verified": { "type": "boolean" },
        "qrData": { "type": "string" },
        "method": { "type": "string", "enum": ["manual", "qr", "GPS"] },
        "groupId": { "type": "string" },
        "updatedBy": { "type": "string" }
      },
      "required": ["userId", "type", "timestamp"]
    },
    "Group": {
      "title": "Organization Group",
      "description": "Global settings for the attendance group",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "groupCode": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "deleted": { "type": "boolean" }
      },
      "required": ["name", "createdBy"]
    },
    "Message": {
      "title": "Chat Message",
      "description": "Inner group communication",
      "type": "object",
      "properties": {
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "text": { "type": "string" },
        "groupId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["senderId", "text", "timestamp"]
    },
    "LeaveRequest": {
      "title": "Leave Request",
      "description": "Request for time off",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "reason": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "date": { "type": "string" },
        "groupId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "reason", "date"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "Company news",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "content": { "type": "string" },
        "authorId": { "type": "string" },
        "groupId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "content"]
    }
  },
  "firestore": {
    "/users/{userId}/profiles/{profileId}": {
      "schema": "User",
      "description": "Sub-profiles for a specific user account (Admin/Worker switch capability)"
    },
    "/attendance/{recordId}": {
      "schema": "Attendance",
      "description": "Global attendance records"
    },
    "/settings/group": {
      "schema": "Group",
      "description": "Global group configuration"
    },
    "/messages/{msgId}": {
      "schema": "Message",
      "description": "Company chat messages"
    },
    "/leaves/{leaveId}": {
      "schema": "LeaveRequest",
      "description": "Employee leave requests"
    },
    "/announcements/{infoId}": {
      "schema": "Announcement",
      "description": "Global company broadcast messages"
    }
  }
}
